# ---------------------------------------------------------------------------
# CELEVATE server configuration. Copy to .env.local and fill in what you need.
# ---------------------------------------------------------------------------

# Secret for signing exam/practice session, result and reveal tokens (HMAC-SHA256).
# Required in production (min 32 characters). Without it production uses a
# per-process key, so sessions break across restarts and server instances.
CELEVATE_SIGNING_SECRET=

# Staff accounts for /admin: "Name:role:token" separated by ";".
# Roles: admin (everything), reviewer (verify, SME decisions, reports), author (drafts).
# Tokens must be at least 24 random characters.
# Example: CELEVATE_STAFF=Ana Reyes:admin:<token>;Ben Cruz:reviewer:<token>
CELEVATE_STAFF=

# Optional single admin token (equivalent to "Administrator:admin:<token>").
CELEVATE_ADMIN_TOKEN=

# Optional PostgreSQL / Supabase connection. When set, the question bank, versions,
# reports, attempts and audit log are stored in the database (see supabase/migrations).
# When empty, the version-controlled JSON files in data/question-bank are used.
DATABASE_URL=
# Set to 0 to disable TLS for non-local databases (not recommended).
DATABASE_SSL=

# File store writes: enabled automatically in `next dev`. Set to 1 to allow admin
# edits on a self-hosted server with a writable disk, or 0 to force read-only.
QBANK_FILE_WRITES=

# Optional: enables live CELEVATE AI answers via Claude.
# Without it, the tutor runs in a clearly labelled demo mode.
ANTHROPIC_API_KEY=
