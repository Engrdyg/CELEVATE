{
  "name": "celevate",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "qbank:verify": "python3 data/question-bank/verify/run.py --write",
    "qbank:validate": "tsx scripts/qbank/validate.ts --write-reports",
    "qbank:promote": "tsx scripts/qbank/promote.ts",
    "qbank:catalog": "tsx scripts/qbank/catalog.ts",
    "qbank:pipeline": "npm run qbank:verify && npm run qbank:validate && tsx scripts/qbank/promote.ts --publish && npm run qbank:catalog && npm run qbank:validate",
    "qbank:db:import": "tsx scripts/qbank/db-import.ts",
    "qbank:db:export": "tsx scripts/qbank/db-export.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "katex": "^0.19.0",
    "lucide-react": "^1.57.0",
    "motion": "^14.3.0",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
